# Copia a apps/web/.env.production (gitignored) para un build de producción local,
# o configura las mismas claves en Vercel → Environment Variables → Production.
#
# `next build` / Vercel usan entorno "production".

NEXT_PUBLIC_API_URL=https://trofo-school-api.fly.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_or_pk_test_...
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_or_pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...

# Servidor / middleware (Vercel)
CLERK_SECRET_KEY=sk_live_or_sk_test_...
