# =============================================================================
# API Nest — variables de entorno
#
# LOCAL (pnpm dev:api / nest start --watch)
#   1) apps/api/.env.development  ← versionado: DB local, CORS localhost, etc.
#   2) apps/api/.env              ← opcional, gitignored: todo en uno (legacy)
#   3) apps/api/.env.local        ← opcional, gitignored: secretos (recomendado)
#
# FLY / UAT (único entorno “live” de la API hoy)
#   Nada de esto va en archivos del repo. Usa: fly secrets set -a trofo-school-api
#   NODE_ENV=production y PORT=8080 vienen del Dockerfile / fly.toml.
#
# Prisma (migrate, seed) desde packages/database necesita DATABASE_URL en el
# entorno o en packages/database/.env (misma URL local que arriba).
# =============================================================================

# --- Solo Fly (fly secrets) — NO copies la URL de prod a .env local ----------
# DATABASE_URL=postgresql://...           # Postgres adjunto a Fly
# CLERK_SECRET_KEY=sk_live_... o sk_test_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# WEB_ORIGIN=https://edifyacademy.co,https://www.edifyacademy.co
# REDIS_URL=redis://...                    # si usas Redis en Fly
# SMTP_HOST=...
# SMTP_USER=...
# SMTP_PASS=...
# MAIL_FROM="Edify <contacto@...>"
# ACADEMY_CONTACT_EMAIL=...
# SUPPORT_NOTIFY_EMAIL=...

# --- Local: secretos (crear apps/api/.env.local a partir de estas líneas) -----
CLERK_SECRET_KEY="sk_test_..."
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
EXPO_PUSH_ACCESS_TOKEN=
SUPPORT_ADMIN_CLERK_IDS=

# Correo local (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=
MAIL_FROM="Edify <tu_cuenta@gmail.com>"
SUPPORT_NOTIFY_EMAIL=camiloavict+edify@gmail.com
ACADEMY_CONTACT_EMAIL=contacto@edifyacademy.co
