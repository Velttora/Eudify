# Debe coincidir con el Postgres que escucha en el puerto indicado (p. ej. docker-compose en la raíz).
# Si la API falla al arrancar con Prisma P1000, usuario/contraseña o puerto no coinciden con ese servidor.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/trofoschool?schema=public"
CLERK_SECRET_KEY="sk_test_..."
PORT=4000
# Origen del front (CORS). En Fly: misma URL que ves en el navegador, sin barra final. Varios: https://a.com,https://www.a.com
WEB_ORIGIN=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 500 = 5%
PLATFORM_FEE_BPS=500

# Correo (Nodemailer). Sin esto, los avisos de ticket solo se registran en log y no se envían.
# Gmail: usar contraseña de aplicación en SMTP_PASS (https://support.google.com/accounts/answer/185833).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=
MAIL_FROM="Edify <tu_cuenta@gmail.com>"
# Bandeja interna de soporte para tickets no formales (por defecto: camiloavict+edify@gmail.com).
SUPPORT_NOTIFY_EMAIL=camiloavict+edify@gmail.com
# PQR (reclamación formal), formulario flotante sugerencias/quejas (por defecto: contacto@edifyacademy.co).
ACADEMY_CONTACT_EMAIL=contacto@edifyacademy.co

# Chat en tiempo real (Family <-> Educator)
CHAT_ENABLED=true
CHAT_RATE_WINDOW_MS=30000
CHAT_RATE_MAX_MESSAGES=25

# Realtime horizontal scaling (opcional; si falta, funciona en una sola instancia)
REDIS_URL=redis://127.0.0.1:6379

# Push (opcional) para usuarios offline - Expo
EXPO_PUSH_ACCESS_TOKEN=
