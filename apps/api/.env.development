# =============================================================================
# SOLO desarrollo local (versionado). No pongas aquí URLs de Fly ni secretos.
# Secretos → apps/api/.env.local o apps/api/.env (ambos gitignored).
# Orden de carga: este archivo primero, luego .env, luego .env.local (gana el último).
# =============================================================================

PORT=4000
# Postgres local (docker compose en la raíz del monorepo, puerto 5433).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/trofoschool?schema=public
# CORS: orígenes del front en tu máquina (Next suele usar localhost o 127.0.0.1).
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

PLATFORM_FEE_BPS=500
CHAT_ENABLED=true
CHAT_RATE_WINDOW_MS=30000
CHAT_RATE_MAX_MESSAGES=25

# Redis local (opcional): solo si tienes Redis en marcha; si no, no definas REDIS_URL
# o la API en dev omitirá el adaptador. En Fly: fly secrets set REDIS_URL=...
# REDIS_URL=redis://127.0.0.1:6379
