# =============================================================================
# Edify — entornos (local vs Fly / UAT)
#
# La API en Fly usa SOLO `fly secrets` + Dockerfile/fly.toml (NODE_ENV=production).
# En local, la API carga: apps/api/.env.development → apps/api/.env → apps/api/.env.local
#
# La web: `next dev` → apps/web/.env.development (+ .env.local para secretos).
#         Vercel / build prod → variables del dashboard o apps/web/.env.production (local, gitignored).
# =============================================================================

# --- Web local (apps/web/.env.local) -----------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# --- API local: prefer apps/api/.env.local para secretos --------------------
# Ver apps/api/.env.example y apps/api/.env.development

# --- Fly (API) — desde la raíz del repo -------------------------------------
# fly secrets set -a trofo-school-api DATABASE_URL="postgresql://..." \
#   CLERK_SECRET_KEY="sk_..." WEB_ORIGIN="https://tu-dominio.com,https://www...."
# fly secrets list -a trofo-school-api

# --- Vercel (web) ------------------------------------------------------------
# Ver apps/web/.env.vercel.example

# --- Prisma / seed ------------------------------------------------------------
# packages/database/.env → misma DATABASE_URL que en local (docker :5433)
# Seed destructivo en prod: ALLOW_SEED_RESET=true (ver packages/database/prisma/seed.ts)
